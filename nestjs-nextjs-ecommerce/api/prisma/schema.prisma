// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  //output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// create database schema modules

// Role Enumerator
enum Role {
  // two types: USER and ADMIN
  USER
  ADMIN
}

// User Table
model User {
  id String @id @default(uuid())
  email String @unique
  password String 
  firstName String?
  lastName String?
  role Role @default(USER)
  refreshToken String?

  // one-to-many relationship: One user can order multiple orders
  orders Order[]

  // one-to-many relationship: One user can have multiple carts
  carts Cart[]

  // one-to-one many relationship: One user can submit multiple payments
  payments Payment[]

  // Time
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // create a new database called index
  @@index([email])
  @@map("users")
}

// Order Status Enumerator
enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

// Order Table
model Order {
  id String @id @default(uuid())
  orderNumber String @unique @default(cuid())
  status OrderStatus 
  totalAmount Decimal @db.Decimal(10, 2)

  userId String

   // one-to-one relationship because an order can be created only by one user
      //   - fields: my current field: userId
      //   - references: refers to id from User model
      //   - onDelete: What happens when a user is deleted?
      //     Cascade: When a user is deletes, all orders associated with this specified order are also deleted simultaneously
  user User @relation(fields: [userId], references:[id], onDelete: Cascade)

  cartId String?
  cart Cart? @relation(fields: [cartId], references: [id])

  shippingAddress String?

  orderItems OrderItem[]

  payment Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@map("orders")

}

// Cart Table
model Cart {
  id String @id @default(uuid())
  
  // one-to-one relationship because a cart can be created only by one user
      //   - fields: my current field: userId
      //   - references: refers to id from User model
      //   - onDelete: What happens when a user is deleted?
      //     Cascade: When a user is deletes, all carts associated with this specified cart are also deleted simultaneously
  userId String
  user User @relation(fields: [userId], references:[id], onDelete: Cascade)
    
  order Order[]
  checkedOut Boolean @default(false)

  cartItems CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("carts")


}

// Payment Status Enumerator
enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// Payment Table
model Payment {
  id String @id @default(uuid())
  amount Decimal @db.Decimal(10, 2)
  status PaymentStatus @default(PENDING)
  currency String @default("usd")
  paymentMethod String?
  transactionId String?


  // one-to-one relationship because a payment can be created only by one user
  //   - fields: my current field: userId
  //   - references: refers to id from User model
  //   - onDelete: What happens when a user is deleted?
  //     Cascade: When a user is deletes, all payments associated with this specified payment are also deleted simultaneously
  userId String
  user User @relation(fields: [userId], references:[id], onDelete: Cascade)

  // One-to-one orderId because one payment can be associated with only one order
  orderId String @unique
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([userId])
  @@index([transactionId])
  @@map("payments")


}

// Product Table
model Product {
  id String @id @default(uuid())
  name String
  description String?
  price Decimal @db.Decimal(10, 2)
  stock Int @default(0)
  sku String @unique
  imageURL String?
  isActive Boolean @default(true)

  // Relations
  orderItems OrderItem[]
  cartItems CartItem[]

  categoryId String
  category Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sku])
  @@index([categoryId])
  @@index([isActive])
  @@map("products")

}

// Category Table
model Category {
  id String @id @default(uuid())
  name String
  description String?
  slug String @unique
  imageUrl String?
  isActive Boolean @default(true)
  
  products Product[] 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([isActive])
  @@map("categories")

}

// OrderItem Table
model OrderItem {
  id String @id @default(uuid())
  quantity Int
  price Decimal @db.Decimal(10, 2)

  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  orderId String
  order Order @relation(fields:[orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// CartItem Table
model CartItem {
  id String @id @default(uuid())
  quantity Int @default(1)

  productId String
  product Product @relation(fields: [productId], references: [id])

  cartId String
  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}


